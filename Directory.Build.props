<Project>
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)dist/.cache/dotnet/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)dist/.cache/dotnet/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**;$(MSBuildThisFileDirectory)dist/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
