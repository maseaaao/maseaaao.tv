{
  "name": "maseaaao-tv",
  "compatibility_date": "2026-01-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.75,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.5,
      "persist": true
    },
    "issues": {
      "enabled": false
    }
  }
}
