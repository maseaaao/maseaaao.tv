{
  "schemaVersion": 2,
  "repository": "maseaaao/maseaaao.tv",
  "products": [
    {
      "id": "stream-info",
      "path": "apps/stream-info",
      "files": [
        {
          "source": "dist/stream-info",
          "target": "."
        }
      ],
      "build": "bun run build:stream-info",
      "browser": false,
      "dotnet": true,
      "activation": "Reload INFO. Import changed C# separately into existing Actions.",
      "requires": {},
      "looseFiles": ["change-info-streamer-bot.ru.html"]
    },
    {
      "id": "tuna-widget",
      "path": "apps/tuna-widget",
      "files": [
        {
          "source": "dist/tuna-widget/obs-tuna-widget.html",
          "target": "obs-tuna-widget.html"
        }
      ],
      "build": "bun run build:tuna",
      "browser": true,
      "dotnet": false,
      "activation": "Reload OBS browser source, preserving URL parameters.",
      "requires": {},
      "looseFiles": ["obs-tuna-widget.html"]
    },
    {
      "id": "obs-widgets",
      "path": "apps/obs-widgets",
      "files": [
        {
          "source": "dist/obs-widgets",
          "target": "."
        }
      ],
      "build": "bun run build:widgets",
      "browser": false,
      "dotnet": false,
      "activation": "Reload local sources. Apply provider CSS separately.",
      "requires": {}
    },
    {
      "id": "artwork",
      "path": "artwork",
      "files": [
        {
          "source": "dist/artwork/logo",
          "target": "logo"
        },
        {
          "source": "dist/artwork/scenes",
          "target": "scenes"
        },
        {
          "source": "dist/artwork/banners",
          "target": "banners"
        },
        {
          "source": "dist/artwork/twitch-description",
          "target": "twitch-description"
        },
        {
          "source": "dist/artwork/wallpapers",
          "target": "wallpapers"
        },
        {
          "source": "dist/artwork/brand/website",
          "target": "brand"
        }
      ],
      "build": "bun run render:all",
      "browser": true,
      "dotnet": false,
      "activation": "Images ready. OBS source paths must point into this product directory.",
      "requires": {},
      "extensions": [".png", ".webp", ".jpg", ".jpeg", ".ico", ".svg"]
    },
    {
      "id": "system-microphone",
      "path": "integrations/companion/system-microphone",
      "files": [
        {
          "source": "dist/companion/system-microphone/local-system-microphone-{version}.tgz",
          "target": "local-system-microphone-{version}.tgz"
        }
      ],
      "build": "bun run --filter ./integrations/companion/system-microphone build && bun run --filter ./integrations/companion/system-microphone package",
      "browser": false,
      "dotnet": true,
      "activation": "Package downloaded only. Export Companion settings, import TGZ and select the version in existing connections.",
      "requires": {}
    },
    {
      "id": "voice-stream",
      "path": "integrations/companion/voice-control",
      "files": [
        {
          "source": "dist/companion/voice-control/local-voice-stream-{version}.tgz",
          "target": "local-voice-stream-{version}.tgz"
        }
      ],
      "build": "bun run --filter ./integrations/companion/voice-control build && bun run --filter ./integrations/companion/voice-control package",
      "browser": false,
      "dotnet": true,
      "activation": "Package downloaded only. Export Companion settings, import TGZ and select the version in existing connections.",
      "requires": {}
    },
    {
      "id": "windows-integrations",
      "path": "tooling/windows",
      "files": [
        {
          "source": "dist/windows-integrations/start-companion.ts",
          "target": "start-companion.ts"
        },
        {
          "source": "dist/windows-integrations/companion-processes.wsf",
          "target": "companion-processes.wsf"
        },
        {
          "source": "dist/windows-integrations/diagnostics/check-stream-stack-cli.ts",
          "target": "diagnostics/check-stream-stack-cli.ts"
        },
        {
          "source": "dist/windows-integrations/diagnostics/check-stream-stack.ts",
          "target": "diagnostics/check-stream-stack.ts"
        },
        {
          "source": "dist/windows-integrations/diagnostics/action-targets.ts",
          "target": "diagnostics/action-targets.ts"
        },
        {
          "source": "dist/windows-integrations/diagnostics/companion-storage.ts",
          "target": "diagnostics/companion-storage.ts"
        },
        {
          "source": "dist/windows-integrations/diagnostics/diagnostic-types.ts",
          "target": "diagnostics/diagnostic-types.ts"
        },
        {
          "source": "dist/windows-integrations/diagnostics/compare-companion-storage.mjs",
          "target": "diagnostics/compare-companion-storage.mjs"
        },
        {
          "source": "dist/windows-integrations/README.md",
          "target": "README.md"
        },
        {
          "source": "dist/windows-integrations/actions/chat-sound/Action.cs",
          "target": "actions/chat-sound/Action.cs"
        },
        {
          "source": "dist/windows-integrations/actions/chat-sound/notif.mp3",
          "target": "actions/chat-sound/notif.mp3"
        },
        {
          "source": "dist/windows-integrations/actions/donationalerts/DonationAlertsAuthorization.cs",
          "target": "actions/donationalerts/DonationAlertsAuthorization.cs"
        },
        {
          "source": "dist/windows-integrations/actions/donationalerts/DonationAlertsIntegration.cs",
          "target": "actions/donationalerts/DonationAlertsIntegration.cs"
        },
        {
          "source": "dist/windows-integrations/actions/donationalerts/DonationAlertsWatcher.cs",
          "target": "actions/donationalerts/DonationAlertsWatcher.cs"
        },
        {
          "source": "dist/windows-integrations/actions/donationalerts/DonationChat.cs",
          "target": "actions/donationalerts/DonationChat.cs"
        },
        {
          "source": "dist/windows-integrations/actions/donationalerts/LICENSE",
          "target": "actions/donationalerts/LICENSE"
        },
        {
          "source": "dist/windows-integrations/actions/donationalerts/README.md",
          "target": "actions/donationalerts/README.md"
        },
        {
          "source": "dist/windows-integrations/actions/donationalerts/WebSocketMessages.cs",
          "target": "actions/donationalerts/WebSocketMessages.cs"
        },
        {
          "source": "dist/windows-integrations/actions/obs-health/Check.cs",
          "target": "actions/obs-health/Check.cs"
        },
        {
          "source": "dist/windows-integrations/actions/obs-health/health-warning.mp3",
          "target": "actions/obs-health/health-warning.mp3"
        },
        {
          "source": "dist/windows-integrations/actions/obs-health/CompanionEndpoint.cs",
          "target": "actions/obs-health/CompanionEndpoint.cs"
        },
        {
          "source": "dist/windows-integrations/actions/obs-health/SoundToggle.cs",
          "target": "actions/obs-health/SoundToggle.cs"
        }
      ],
      "build": "bun run build:windows && bun tooling/bundle-release.ts --validate-catalog",
      "browser": false,
      "dotnet": false,
      "activation": "Set STREAMERBOT_ROOT explicitly. Update launcher and Action paths once; no automatic application reconfiguration.",
      "requires": {},
      "versionFile": "tooling/windows/version.json"
    },
    {
      "id": "website",
      "path": "apps/website",
      "files": [
        {
          "source": "dist/website",
          "target": "."
        }
      ],
      "build": "bun run build:website",
      "browser": false,
      "dotnet": false,
      "activation": "Static website only; no Cloudflare publication.",
      "requires": {},
      "versionFile": "apps/website/release-version.json"
    }
  ]
}
