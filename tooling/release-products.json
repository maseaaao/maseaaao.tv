        }
      ],
      "test": "python -m unittest discover -s tests -p \"test_release*.py\"",
      "build": "python tooling/package-release.py --validate-catalog",
      "browser": false,
      "activation": "Set STREAMERBOT_ROOT explicitly. Update launcher and Action paths once; no automatic application reconfiguration.",
      "requires": {},
      "versionFile": "tooling/windows/version.json"
    },
    {
      "id": "website",
      "tagPrefix": "website-v",
      "path": "apps/website",
      "files": [
        {
          "source": "dist",
          "target": "."
        }
      ],
      "test": "pnpm --filter ./apps/website run check",
      "build": "pnpm run build:website",
      "browser": false,
      "activation": "Static website only; no Cloudflare publication.",
      "requires": {},
