{
  "schemaVersion": 1,
  "repository": "maseaaao/maseaaao.tv",
  "products": [
    {
      "id": "stream-info",
      "tagPrefix": "stream-info-v",
      "path": "apps/stream-info",
      "files": [
        {
          "source": "apps/stream-info/dist",
          "target": "."
        },
        {
          "source": "apps/stream-info/streamerbot-import.txt",
          "target": "streamerbot-import.txt"
        }
      ],
      "test": "pnpm run test:stream-info",
      "build": "pnpm run build:stream-info",
      "browser": false,
      "activation": "Reload INFO. Import changed C# separately into existing Actions.",
      "requires": {},
      "looseFiles": ["change-info-streamer-bot.ru.html"]
    },
    {
      "id": "tuna-widget",
      "tagPrefix": "tuna-widget-v",
      "path": "apps/tuna-widget",
      "files": [
        {
          "source": "apps/tuna-widget/dist/obs-tuna-widget.html",
          "target": "obs-tuna-widget.html"
        }
      ],
      "test": "node --test tests/tuna-widget.test.mjs",
      "build": "pnpm run build:tuna",
      "browser": true,
      "activation": "Reload OBS browser source, preserving URL parameters.",
      "requires": {},
      "looseFiles": ["obs-tuna-widget.html"]
    },
    {
      "id": "obs-widgets",
      "tagPrefix": "obs-widgets-v",
      "path": "apps/obs-widgets",
      "files": [
        {
          "source": "apps/obs-widgets/dist",
          "target": "."
        }
      ],
      "test": "pnpm --filter ./apps/obs-widgets run check",
      "build": "pnpm run build:widgets",
      "browser": false,
      "activation": "Reload local sources. Apply provider CSS separately.",
      "requires": {}
    },
    {
      "id": "artwork",
      "tagPrefix": "artwork-v",
      "path": "artwork",
      "files": [
        {
          "source": "artwork/logo/rendered",
          "target": "logo"
        },
        {
          "source": "artwork/scenes/rendered",
          "target": "scenes"
        },
        {
          "source": "artwork/banners/rendered",
          "target": "banners"
        },
        {
          "source": "artwork/twitch-description/rendered",
          "target": "twitch-description"
        },
        {
          "source": "artwork/wallpapers/rendered",
          "target": "wallpapers"
        },
        {
          "source": "artwork/brand/rendered/website",
          "target": "brand"
        }
      ],
      "test": "pnpm --filter ./artwork run check",
      "build": "pnpm run verify:artwork",
      "browser": true,
      "activation": "Images ready. OBS source paths must point into this product directory.",
      "requires": {},
      "extensions": [".png", ".webp", ".jpg", ".jpeg", ".ico", ".svg"],
      "pythonRequirements": "tooling/artwork/requirements-fonts.txt"
    },
    {
      "id": "system-microphone",
      "tagPrefix": "system-microphone-v",
      "path": "integrations/companion/system-microphone",
      "files": [
        {
          "source": "integrations/companion/system-microphone/local-system-microphone-{version}.tgz",
          "target": "local-system-microphone-{version}.tgz"
        }
      ],
      "test": "pnpm run test:companion && node --test tests/companion-build.test.mjs",
      "build": "pnpm --filter ./integrations/companion/system-microphone run build && pnpm --filter ./integrations/companion/system-microphone run package",
      "browser": false,
      "activation": "Package downloaded only. Export Companion settings, import TGZ and select the version in existing connections.",
      "requires": {}
    },
    {
      "id": "voice-stream",
      "tagPrefix": "voice-stream-v",
      "path": "integrations/companion/voice-control",
      "files": [
        {
          "source": "integrations/companion/voice-control/local-voice-stream-{version}.tgz",
          "target": "local-voice-stream-{version}.tgz"
        }
      ],
      "test": "pnpm run test:companion && node --test tests/companion-build.test.mjs",
      "build": "pnpm --filter ./integrations/companion/voice-control run build && pnpm --filter ./integrations/companion/voice-control run package",
      "browser": false,
      "activation": "Package downloaded only. Export Companion settings, import TGZ and select the version in existing connections.",
      "requires": {}
    },
    {
