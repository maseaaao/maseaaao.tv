    "text": [
      "Stream",
      "Checker",
      "Добавить",
      "все",
      "Удалить",
      "все",
      "YouTube",
      "iframe",
      "не",
      "создан",
      "Добавить",
      "Удалить",
      "Открыть",
      "YouTube-плеер",
      "не",
      "загружен",
      "Twitch",
      "iframe",
      "не",
      "создан",
      "Добавить",
      "Удалить",
      "Открыть",
      "Twitch-плеер",
      "не",
      "загружен"
    ],
    "script": [
      "\n      const SEARCH_PARAMS = new URLSearchParams(window.location.search);\n      const IS_TV_MODE = SEARCH_PARAMS.get(\"tv\") === \"1\";\n\n      if (IS_TV_MODE) {\n        document.body.classList.add(\"is-tv-mode\");\n      }\n\n      const STREAMS = {\n        youtube: {\n          title: \"YouTube live\",\n          get src() {\n            const params = new URLSearchParams({\n              channel: \"UCyJNPWpOcPfMo5csKa27yGg\",\n              autoplay: \"1\",\n              mute: IS_TV_MODE ? \"0\" : \"1\",\n            });\n\n            return `https://www.youtube.com/embed/live_stream?${params.toString()}`;\n          },\n          allow: \"autoplay; encrypted-media; picture-in-picture; fullscreen\",\n        },\n\n        twitch: {\n          title: \"Twitch live\",\n          get src() {\n            const parent = window.location.hostname;\n\n            if (!parent) {\n              throw new Error(\"Twitch iframe requires a real hostname.\");\n            }\n\n            const params = new URLSearchParams({\n              channel: \"maseaaao\",\n              parent,\n              autoplay: \"true\",\n              muted: \"true\",\n            });\n\n            return `https://player.twitch.tv/?${params.toString()}`;\n          },\n          allow: \"autoplay; fullscreen\",\n        },\n      };\n\n      function getElements(platform) {\n        const card = document.querySelector(`[data-platform=\"${platform}\"]`);\n\n        return {\n          card,\n          slot: card.querySelector(\"[data-slot]\"),\n          status: card.querySelector(\"[data-status]\"),\n        };\n      }\n\n      function setPlaceholder(slot, platform) {\n        const label = {\n          youtube: \"YouTube-плеер не загружен\",\n          twitch: \"Twitch-плеер не загружен\",\n        }[platform];\n\n        slot.replaceChildren(\n          Object.assign(document.createElement(\"div\"), {\n            className: \"placeholder\",\n            textContent: label,\n          }),\n        );\n      }\n\n      function setError(slot, status, message) {\n        slot.replaceChildren(\n          Object.assign(document.createElement(\"div\"), {\n            className: \"placeholder\",\n            textContent: message,\n          }),\n        );\n\n        status.textContent = \"ошибка\";\n      }\n\n      function addPlayer(platform) {\n        const config = STREAMS[platform];\n        const { slot, status } = getElements(platform);\n\n        if (slot.querySelector(\"iframe\")) {\n          status.textContent = \"iframe уже создан\";\n          return;\n        }\n\n        try {\n          const iframe = document.createElement(\"iframe\");\n\n          iframe.title = config.title;\n          iframe.src = config.src;\n          iframe.allow = config.allow;\n          iframe.allowFullscreen = true;\n          iframe.referrerPolicy = \"strict-origin-when-cross-origin\";\n\n          slot.replaceChildren(iframe);\n          status.textContent = \"iframe создан\";\n        } catch (error) {\n          setError(\n            slot,\n            status,\n            error instanceof Error\n              ? error.message\n              : \"Не удалось создать iframe\",\n          );\n        }\n      }\n\n      function removePlayer(platform) {\n        const { slot, status } = getElements(platform);\n\n        slot.replaceChildren();\n        setPlaceholder(slot, platform);\n        status.textContent = \"iframe не создан\";\n      }\n\n      document.addEventListener(\"click\", (event) => {\n        const button = event.target.closest(\"button[data-action]\");\n\n        if (!button) {\n          return;\n        }\n\n        const action = button.dataset.action;\n        const card = button.closest(\"[data-platform]\");\n        const platforms = Object.keys(STREAMS);\n\n        if (action === \"add-all\") {\n          platforms.forEach(addPlayer);\n          return;\n        }\n\n        if (action === \"remove-all\") {\n          platforms.forEach(removePlayer);\n          return;\n        }\n\n        if (!card) {\n          return;\n        }\n\n        const platform = card.dataset.platform;\n\n        if (action === \"add\") {\n          addPlayer(platform);\n        }\n\n        if (action === \"remove\") {\n          removePlayer(platform);\n        }\n      });\n\n      if (IS_TV_MODE) {\n        Object.keys(STREAMS).forEach(addPlayer);\n      }\n    "
    ]
  },
