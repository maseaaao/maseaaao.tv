* text=auto
*.mjs text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.webmanifest text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.ps1 text eol=crlf
# Files copied verbatim into the published dist/ must keep LF on every
# operating system, otherwise the byte-for-byte artifact comparison differs
# between a Windows and a Linux checkout.
apps/website/public/_headers text eol=lf
apps/website/public/sitemap.xml text eol=lf
apps/website/public/.well-known/api-catalog text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp3 binary

# Generated Stream Info distributables are excluded from language statistics.
apps/stream-info/change-info-streamer-bot.html linguist-generated=true
apps/stream-info/dist/** linguist-generated=true
