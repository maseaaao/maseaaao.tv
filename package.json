{
  "name": "maseaaao-tv",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/companion/system-microphone",
    "integrations/companion/voice-control",
    "artwork",
    "tooling"
  ],
  "scripts": {
    "browser:install": "playwright-core install chromium --no-shell",
    "build": "bun run build:website",
    "build:all": "bun run --sequential build:artwork build:apps build:ui",
    "build:apps": "bun run --sequential build:website build:stream-info build:tuna build:widgets build:windows",
    "build:artwork": "bun tooling/run-task.ts @maseaaao/artwork#build",
    "build:cloudflare": "bun run render:all && bun run --sequential build:website build:stream-info build:tuna build:widgets build:ui prepare:cloudflare",
    "build:companion": "bun tooling/run-task.ts @maseaaao/tooling#build:companion",
    "build:diagnostics": "bun tooling/run-task.ts @maseaaao/tooling#build:diagnostics",
    "build:stream-info": "bun tooling/run-task.ts change-info-streamer-bot#build",
    "build:tuna": "bun tooling/run-task.ts @maseaaao/tuna-widget#build",
    "build:ui": "bun tooling/run-task.ts @maseaaao/ui-gallery#build",
    "build:website": "bun tooling/run-task.ts @maseaaao/website#build",
    "build:widgets": "bun tooling/run-task.ts @maseaaao/obs-widgets#build",
    "build:windows": "bun tooling/run-task.ts @maseaaao/tooling#build:windows",
    "check": "bun run --sequential check:hooks check:code check:repository",
    "check:biome": "bun tooling/run-task.ts @maseaaao/tooling#check:biome",
    "check:build-config": "bun tooling/run-task.ts @maseaaao/build-config#check",
    "check:code": "bun run --sequential check:biome check:knip check:types",
    "check:companion": "bun tooling/run-task.ts check --filter='./integrations/companion/*'",
    "check:fix": "biome check --write --error-on-warnings .",
    "check:hooks": "bun run --bun -- lefthook validate",
    "check:knip": "bun tooling/run-task.ts @maseaaao/tooling#check:knip",
    "check:repository": "bun tooling/check-repository.ts",
    "check:tooling": "bun tooling/run-task.ts @maseaaao/tooling#check",
    "check:types": "bun run --sequential check:ui check:tooling check:companion check:build-config",
    "check:ui": "bun tooling/run-task.ts check --filter='./apps/*'",
    "deploy:website": "bunx --bun wrangler deploy",
    "dev": "bun tooling/dev.ts",
    "dev:ui": "bun run --filter ./apps/ui-gallery dev",
    "format": "biome format --write .",
    "full": "bun run --sequential render:all build:apps",
    "hooks:install": "bun run --bun -- lefthook install",
    "postinstall": "if [ -z \"$CI\" ] && [ -e .git ]; then bun run hooks:install; fi",
    "lint": "biome lint --error-on-warnings .",
    "optimize:images": "bun tooling/artwork/optimize-images.ts",
    "package:companion": "bun tooling/run-task.ts @maseaaao/tooling#package:companion",
    "prepare:cloudflare": "cp _redirects .assetsignore apps/website/public/_headers dist/",
    "render:all": "bun tooling/run-task.ts @maseaaao/tooling#render:all",
    "render:artwork": "bun tooling/artwork/cyber-site-render.ts",
    "render:logo": "bun tooling/artwork/refresh-logo-qr.ts",
    "render:scenes": "bun tooling/artwork/build-cyber-scenes.ts",
    "sync:local": "bun tooling/sync-local.ts",
    "test": "bun run --sequential test:stream-info test:companion test:tuna",
    "test:companion": "bun tooling/run-task.ts @maseaaao/tooling#test:companion",
    "test:csharp": "bun run --filter ./apps/stream-info test:csharp",
    "test:stream-info": "bun tooling/run-task.ts change-info-streamer-bot#test",
    "test:tuna": "bun tooling/run-task.ts @maseaaao/tuna-widget#test",
    "verify:companion": "bun integrations/companion/shared/test-packages.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@maseaaao/design": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/postcss-import": "catalog:",
    "@types/postcss-url": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "playwright-core": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "catalog": {
    "@biomejs/biome": "2.6.3",
    "@companion-module/base": "2.2.1",
    "@sinonjs/fake-timers": "15.4.0",
    "@streamerbot/client": "2.0.1",
    "@types/bun": "1.4.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/postcss-import": "14.0.3",
    "@types/postcss-url": "10.0.4",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "30.1.3",
    "jsonc-parser": "3.3.1",
    "jsqr": "1.4.0",
    "knip": "6.43.0",
    "lucide-static": "1.28.0",
    "playwright-core": "1.64.1",
    "png-to-ico": "3.0.2",
    "postcss": "8.5.31",
    "postcss-import": "17.0.1",
    "postcss-url": "10.1.4",
    "qrcode": "1.5.4",
    "@11ty/eleventy-img": "7.1.1",
    "sharp": "0.35.5",
    "simple-icons": "16.27.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "wrangler": "4.152.0",
    "turbo": "2.11.10",
    "ultracite": "8.0.2",
    "lefthook": "2.2.2"
  },
  "patchedDependencies": {
    "ultracite@8.0.2": "patches/ultracite@8.0.2.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}
