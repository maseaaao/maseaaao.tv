{
  "name": "maseaaao-tv",
  "private": true,
  "scripts": {
    "build": "npm run build:website",
    "build:website": "node tooling/build-website.mjs",
    "build:stream-info": "npm run build --workspace apps/stream-info",
    "check:stream-info": "npm run check --workspace apps/stream-info",
    "test:stream-info": "npm test --workspace apps/stream-info",
    "test:website": "node tooling/artwork/cyber-site-test.mjs",
    "test:companion": "node integrations/companion/shared/test-helper-process.mjs && node integrations/companion/voice-control/test-guard.mjs && node integrations/companion/voice-control/test-runtime.mjs",
    "test": "npm run build:all && npm run test:checks",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:repository",
    "sync:local": "node tooling/sync-local.mjs",
    "build:tuna": "npm run build --workspace apps/tuna-widget",
    "browser:install": "playwright-core install chromium",
    "render:banners": "node tooling/artwork/cyber-site-render.mjs banners",
    "render:logo": "node tooling/artwork/refresh-logo-qr.mjs",
    "render:scenes": "node tooling/artwork/build-cyber-scenes.mjs",
    "render:twitch-description": "node tooling/artwork/cyber-site-render.mjs panels",
    "render:favicon": "node tooling/artwork/cyber-site-render.mjs favicon",
    "brand:assets": "node tooling/artwork/cyber-site-render.mjs brand",
    "optimize:images": "node tooling/artwork/optimize-images.mjs",
    "full": "npm run render:logo && npm run build:fonts && npm run render:scenes && npm run render:cyber-site && npm run build:all",
    "render:cyber-site": "node tooling/artwork/cyber-site-render.mjs",
    "render:wallpapers": "node tooling/artwork/cyber-site-render.mjs wallpapers",
    "build:fonts": "python tooling/artwork/build-web-fonts.py",
    "prepare:companion-libs": "powershell -NoProfile -ExecutionPolicy Bypass -File tooling/prepare-companion-libs.ps1",
    "test:local": "node tooling/local/test-action-targets.mjs && python tooling/local/test-companion-storage.py",
    "build:widgets": "npm run build --workspace apps/obs-widgets",
    "build:all": "npm run build:tuna && npm run build:stream-info && npm run build:widgets && npm run build:website",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"{apps,packages,artwork}/**/*.{css,html}\" --max-warnings=0",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "typecheck": "npm run check:stream-info",
    "build:artwork": "node tooling/build-artwork.mjs",
    "test:checks": "npm run test:website && npm run test:stream-info && npm run test:companion && npm run test:local",
    "check:repository": "node tooling/check-repository.mjs",
    "build:ui-probe": "npm run build --workspace tooling/ui-portability",
    "test:ui-probe": "npm run build:ui-probe && npm test --workspace tooling/ui-portability"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@html-eslint/eslint-plugin": "0.67.0",
    "@html-eslint/parser": "0.67.0",
    "@maseaaao/build-config": "1.0.0",
    "@maseaaao/design": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsonc-parser": "3.3.1",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.58.2",
    "png-to-ico": "3.0.2",
    "postcss": "8.5.31",
    "postcss-html": "2.0.0",
    "postcss-import": "17.0.1",
    "postcss-url": "10.1.4",
    "prettier": "3.9.10",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.4",
    "jsdom": "26.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/companion/system-microphone",
    "integrations/companion/voice-control",
    "tooling/ui-portability"
  ],
  "engines": {
    "node": ">=22.20 <23"
  }
}
