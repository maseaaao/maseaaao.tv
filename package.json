{
  "name": "maseaaao-tv",
  "private": true,
  "scripts": {
    "build": "npm run build:website",
    "build:website": "node tooling/prepare-inline-design.mjs && node tooling/build-website.mjs",
    "build:stream-info": "npm run build --workspace apps/stream-info",
    "check:stream-info": "npm run check --workspace apps/stream-info",
    "test:stream-info": "npm test --workspace apps/stream-info",
    "test:website": "node tooling/artwork/cyber-site-test.mjs",
    "test:brand-color-lab": "npm test --workspace apps/brand-color-lab",
    "test:companion": "node integrations/companion/shared/test-helper-process.mjs && node integrations/companion/system-microphone/test-upgrade.mjs && node integrations/companion/voice-control/test-guard.mjs && node integrations/companion/voice-control/test-runtime.mjs",
    "test": "npm run test:website && npm run test:stream-info && npm run test:companion && npm run test:local",
    "check": "node tooling/check-repository.mjs",
    "sync:local": "node tooling/sync-local.mjs",
    "build:tuna": "npm run build --workspace apps/tuna-widget",
    "browser:install": "playwright-core install chromium",
    "render:youtube-banner": "node tooling/artwork/cyber-site-render.mjs banners",
    "render:twitch-banner": "node tooling/artwork/cyber-site-render.mjs banners",
    "render:logo": "node tooling/artwork/refresh-logo-qr.mjs",
    "render:scenes": "node tooling/artwork/build-cyber-scenes.mjs",
    "render:twitch-description": "node tooling/artwork/cyber-site-render.mjs panels",
    "render:favicon": "node tooling/artwork/cyber-site-render.mjs favicon",
    "brand:assets": "node tooling/artwork/cyber-site-render.mjs brand",
    "brand:subscribe": "node tooling/artwork/cyber-site-render.mjs brand",
    "optimize:images": "node tooling/artwork/optimize-images.mjs",
    "full": "npm run render:logo && npm run build:fonts && npm run build:website && npm run build:cyber && npm run render:cyber-site && npm run build:website",
    "build:noir": "node tooling/artwork/build-cyber-scenes.mjs",
    "build:cyber": "node tooling/artwork/build-cyber-scenes.mjs",
    "render:cyber-site": "node tooling/artwork/cyber-site-render.mjs",
    "render:wallpapers": "node tooling/artwork/cyber-site-render.mjs wallpapers",
    "build:fonts": "python3 tooling/artwork/build-web-fonts.py",
    "prepare:companion-libs": "powershell -NoProfile -ExecutionPolicy Bypass -File tooling/prepare-companion-libs.ps1",
    "test:local": "node tooling/local/test-action-targets.mjs && python tooling/local/test-companion-storage.py"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "npm-run-all": "^4.1.5",
    "playwright-core": "^1.58.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "opentype.js": "^1.3.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/companion/system-microphone",
    "integrations/companion/voice-control"
  ],
  "engines": {
    "node": ">=22.20 <23"
  }
}
