{
  "name": "maseaaao-tv",
  "private": true,
  "scripts": {
    "build": "bun run build:website",
    "build:website": "bun run --filter ./apps/website build",
    "build:stream-info": "bun run --filter ./apps/stream-info build",
    "check:stream-info": "bun run --filter ./apps/stream-info check",
    "test:stream-info": "bun run --filter ./apps/stream-info test",
    "test:website": "bun run test:repository",
    "test:companion": "node integrations/companion/shared/test-helper-process.mjs && node integrations/companion/voice-control/test-guard.mjs && node integrations/companion/voice-control/test-runtime.mjs",
    "test": "bun run build:all && bun run test:checks",
    "check": "bun run check:source && bun run check:repository",
    "sync:local": "node tooling/sync-local.mjs",
    "test:releases": "node --test tests/release-products.test.mjs",
    "build:tuna": "bun run --filter ./apps/tuna-widget build",
    "browser:install": "playwright-core install chromium",
    "render:banners": "node tooling/artwork/cyber-site-render.mjs banners",
    "render:logo": "node tooling/artwork/refresh-logo-qr.mjs",
    "render:scenes": "node tooling/artwork/build-cyber-scenes.mjs",
    "render:twitch-description": "node tooling/artwork/cyber-site-render.mjs panels",
    "render:favicon": "node tooling/artwork/cyber-site-render.mjs favicon",
    "brand:assets": "node tooling/artwork/cyber-site-render.mjs brand",
    "optimize:images": "node tooling/artwork/optimize-images.mjs",
    "full": "bun run render:logo && bun run render:scenes && bun run render:cyber-site && bun run build:all",
    "render:cyber-site": "node tooling/artwork/cyber-site-render.mjs",
    "render:wallpapers": "node tooling/artwork/cyber-site-render.mjs wallpapers",
    "test:local": "node tooling/local/test-action-targets.mjs && node tooling/run-python.mjs tooling/local/test-companion-storage.py",
    "build:widgets": "bun run --filter ./apps/obs-widgets build",
    "build:all": "bun run build:website && bun run build:stream-info && bun run build:tuna && bun run build:widgets && bun run build:artwork",
    "format": "biome format --write .",
    "format:check": "biome format --error-on-warnings .",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "typecheck": "bun run check:stream-info",
    "build:artwork": "bun run --filter ./artwork build",
    "test:checks": "bun run test:repository && bun run test:stream-info && bun run test:companion && bun run test:local",
    "check:repository": "node tooling/check-repository.mjs",
    "check:ui": "bun run --filter \"./apps/*\" --filter ./artwork check",
    "check:source": "bun run check:biome && bun run test:source-policy && bun run check:ui && node tooling/check-repository.mjs --source",
    "test:repository": "node tooling/artwork/cyber-site-test.mjs",
    "verify:artwork": "bun run render:logo && bun run build:artwork && bun run render:scenes --prepared && bun run render:cyber-site all --prepared",
    "verify:products": "bun run build:all",
    "check:artifacts": "node tooling/check-generated-artifacts.mjs",
    "verify:ui-renewal": "bun run check:source && bun run verify:artwork && bun run verify:products && bun run check:repository && bun run test:checks && bun run check:artifacts && git diff --check",
    "render:scene-motion": "node tooling/artwork/render-scene-motion.mjs",
    "check:biome": "biome ci --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "test:source-policy": "node --test tests/biome-policy.test.mjs",
    "verify:companion": "bun run --filter ./integrations/companion/system-microphone build && bun run --filter ./integrations/companion/voice-control build && bun run --filter ./integrations/companion/system-microphone package && bun run --filter ./integrations/companion/voice-control package && node tooling/run-python.mjs integrations/companion/shared/test-packages.py"
  },
  "devDependencies": {
    "@maseaaao/build-config": "workspace:*",
    "@maseaaao/design": "workspace:*",
    "jsdom": "26.1.0",
    "jsonc-parser": "3.3.1",
    "jsqr": "^1.4.0",
    "playwright-core": "1.58.2",
    "png-to-ico": "3.0.2",
    "postcss": "8.5.31",
    "postcss-import": "17.0.1",
    "postcss-url": "10.1.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.4",
    "yaml": "2.8.1",
    "@maseaaao/artwork": "workspace:*",
    "@biomejs/biome": "2.6.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/companion/system-microphone",
    "integrations/companion/voice-control",
    "artwork"
  ],
  "engines": {
    "node": ">=22.20 <23",
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
