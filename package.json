{
  "name": "maseaaao-tv",
  "private": true,
  "scripts": {
    "build": "bun run build:website",
    "build:website": "bun run --filter ./apps/website build",
    "deploy:website": "bun run build:website && bunx --bun wrangler deploy",
    "build:diagnostics": "bun tooling/local/build-diagnostics.mjs",
    "build:stream-info": "bun run --filter ./apps/stream-info build",
    "check:stream-info": "bun run --filter ./apps/stream-info check",
    "test:stream-info": "bun run --filter ./apps/stream-info test",
    "test:website": "bun run test:repository",
    "test:companion": "bun integrations/companion/shared/test-helper-process.mjs && bun integrations/companion/voice-control/test-guard.mjs && bun integrations/companion/voice-control/test-runtime.mjs",
    "test": "bun run build:all && bun run test:checks",
    "check": "bun run check:source && bun run check:repository",
    "sync:local": "bun tooling/sync-local.mjs",
    "test:releases": "bun test tests/release-products.test.mjs",
    "build:tuna": "bun run --filter ./apps/tuna-widget build",
    "browser:install": "playwright-core install chromium",
    "render:banners": "bun tooling/artwork/cyber-site-render.mjs banners",
    "render:logo": "bun tooling/artwork/refresh-logo-qr.mjs",
    "render:scenes": "bun tooling/artwork/build-cyber-scenes.mjs",
    "render:twitch-description": "bun tooling/artwork/cyber-site-render.mjs panels",
    "render:favicon": "bun tooling/artwork/cyber-site-render.mjs favicon",
    "brand:assets": "bun tooling/artwork/cyber-site-render.mjs brand",
    "optimize:images": "bun tooling/artwork/optimize-images.mjs",
    "full": "bun run render:logo && bun run render:scenes && bun run render:cyber-site && bun run build:all",
    "render:cyber-site": "bun tooling/artwork/cyber-site-render.mjs",
    "render:wallpapers": "bun tooling/artwork/cyber-site-render.mjs wallpapers",
    "test:local": "bun tooling/local/test-action-targets.mjs && bun test ./tooling/local/test-companion-storage.mjs",
    "build:widgets": "bun run --filter ./apps/obs-widgets build",
    "build:all": "bun run build:website && bun run build:stream-info && bun run build:tuna && bun run build:widgets && bun run build:artwork && bun run build:diagnostics",
    "format": "biome format --write .",
    "format:check": "biome format --error-on-warnings .",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "typecheck": "bun run check:stream-info",
    "build:artwork": "bun run --filter ./artwork build",
    "test:checks": "bun run test:repository && bun run test:stream-info && bun run test:companion && bun run test:local",
    "check:repository": "bun tooling/check-repository.mjs",
    "check:ui": "bun run --filter \"./apps/*\" --filter ./artwork check",
    "check:source": "bun run check:biome && bun run check:knip && bun run test:source-policy && bun run check:ui && bun tooling/check-repository.mjs --source",
    "test:repository": "bun tooling/artwork/cyber-site-test.mjs",
    "verify:artwork": "bun run render:logo && bun run build:artwork && bun run render:scenes --prepared && bun run render:cyber-site all --prepared",
    "verify:products": "bun run build:all",
    "check:artifacts": "bun tooling/check-generated-artifacts.mjs",
    "verify:ui-renewal": "bun run check:source && bun run verify:artwork && bun run verify:products && bun run check:repository && bun run test:checks && bun run check:artifacts && git diff --check",
    "check:biome": "biome ci --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "test:source-policy": "bun test tests/biome-policy.test.mjs",
    "verify:companion": "bun run --filter ./integrations/companion/system-microphone build && bun run --filter ./integrations/companion/voice-control build && bun run --filter ./integrations/companion/system-microphone package && bun run --filter ./integrations/companion/voice-control package && bun integrations/companion/shared/test-packages.mjs",
    "check:knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@maseaaao/build-config": "workspace:*",
    "@maseaaao/design": "workspace:*",
    "fflate": "0.8.3",
    "jsdom": "26.1.0",
    "jsonc-parser": "3.3.1",
    "jsqr": "^1.4.0",
    "knip": "6.43.0",
    "playwright-core": "1.58.2",
    "png-to-ico": "3.0.2",
    "postcss": "8.5.31",
    "postcss-import": "17.0.1",
    "postcss-url": "10.1.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.4",
    "wrangler": "4.152.0",
    "yaml": "2.8.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/companion/system-microphone",
    "integrations/companion/voice-control",
    "artwork"
  ],
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}
