{
  "name": "maseaaao-tv",
  "private": true,
  "scripts": {
    "build": "pnpm run build:website",
    "build:website": "pnpm --filter ./apps/website run build",
    "build:stream-info": "pnpm --filter ./apps/stream-info run build",
    "check:stream-info": "pnpm --filter ./apps/stream-info run check",
    "test:stream-info": "pnpm --filter ./apps/stream-info run test",
    "test:website": "pnpm run test:repository",
    "test:companion": "node integrations/companion/shared/test-helper-process.mjs && node integrations/companion/voice-control/test-guard.mjs && node integrations/companion/voice-control/test-runtime.mjs",
    "test": "pnpm run build:all && pnpm run test:checks",
    "check": "pnpm run check:source && pnpm run check:repository",
    "sync:local": "node tooling/sync-local.mjs",
    "build:tuna": "pnpm --filter ./apps/tuna-widget run build",
    "browser:install": "playwright-core install chromium",
    "render:banners": "node tooling/artwork/cyber-site-render.mjs banners",
    "render:logo": "node tooling/artwork/refresh-logo-qr.mjs",
    "render:scenes": "node tooling/artwork/build-cyber-scenes.mjs",
    "render:twitch-description": "node tooling/artwork/cyber-site-render.mjs panels",
    "render:favicon": "node tooling/artwork/cyber-site-render.mjs favicon",
    "brand:assets": "node tooling/artwork/cyber-site-render.mjs brand",
    "optimize:images": "node tooling/artwork/optimize-images.mjs",
    "full": "pnpm run render:logo && pnpm run build:fonts && pnpm run render:scenes && pnpm run render:cyber-site && pnpm run build:all",
    "render:cyber-site": "node tooling/artwork/cyber-site-render.mjs",
    "render:wallpapers": "node tooling/artwork/cyber-site-render.mjs wallpapers",
    "build:fonts": "python tooling/artwork/build-web-fonts.py",
    "prepare:companion-libs": "powershell -NoProfile -ExecutionPolicy Bypass -File tooling/prepare-companion-libs.ps1",
    "test:local": "node tooling/local/test-action-targets.mjs && python tooling/local/test-companion-storage.py",
    "build:widgets": "pnpm --filter ./apps/obs-widgets run build",
    "build:all": "node tooling/run-tasks.mjs build --filter=./apps/* --filter=./artwork",
    "format": "biome format --write .",
    "format:check": "biome format --error-on-warnings .",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "typecheck": "pnpm run check:stream-info",
    "build:artwork": "pnpm --filter ./artwork run build",
    "test:checks": "pnpm run test:repository && pnpm run test:stream-info && pnpm run test:companion && pnpm run test:local",
    "check:repository": "node tooling/check-repository.mjs",
    "build:ui-probe": "pnpm --filter ./tooling/ui-portability run build",
    "test:ui-probe": "pnpm --filter ./tooling/ui-portability run test",
    "build:ui-reference": "node tooling/build-ui-reference.mjs",
    "build:storybook": "pnpm --filter ./tooling/ui-catalog run build",
    "test:ui": "node tooling/patch-storybook-windows.mjs && pnpm --filter ./tooling/ui-catalog run test",
    "check:ui": "node tooling/run-tasks.mjs check",
    "check:source": "pnpm run check:biome && pnpm run test:source-policy && pnpm run check:ui && node tooling/check-repository.mjs --source",
    "build:static-fixtures": "pnpm --filter ./tooling/static-fixtures run build",
    "test:static": "pnpm --filter ./tooling/static-fixtures run test",
    "build:ui": "node tooling/run-tasks.mjs build --filter=./tooling/*",
    "verify:artwork": "pnpm run build:fonts && pnpm run render:logo && pnpm run build:artwork && pnpm run render:scenes --prepared && pnpm run render:cyber-site all --prepared",
    "verify:products": "node tooling/run-tasks.mjs build --filter=./apps/* --filter=./artwork --filter=./tooling/*",
    "check:artifacts": "node tooling/check-generated-artifacts.mjs",
    "accept:artifacts": "node tooling/accept-artifacts.mjs",
    "verify:ui-renewal": "pnpm run check:source && pnpm run verify:artwork && pnpm run verify:products && pnpm run check:repository && pnpm run test:ui && pnpm run test:ui-probe && pnpm run test:static && pnpm run test:checks && pnpm run check:artifacts && git diff --check",
    "test:repository": "node tooling/artwork/cyber-site-test.mjs",
    "render:scene-motion": "node tooling/artwork/render-scene-motion.mjs",
    "check:biome": "biome ci --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "test:source-policy": "node --test tests/biome-policy.test.mjs"
  },
  "devDependencies": {
    "@maseaaao/build-config": "workspace:*",
    "@maseaaao/design": "workspace:*",
    "jsdom": "26.1.0",
    "jsonc-parser": "3.3.1",
    "jsqr": "^1.4.0",
    "playwright-core": "1.58.2",
    "png-to-ico": "3.0.2",
    "postcss": "8.5.31",
    "postcss-import": "17.0.1",
    "postcss-url": "10.1.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "turbo": "2.11.10",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.4",
    "yaml": "2.8.1",
    "vue": "3.5.44",
    "@maseaaao/artwork": "workspace:*",
    "@biomejs/biome": "2.6.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/companion/system-microphone",
    "integrations/companion/voice-control",
    "tooling/ui-portability",
    "tooling/ui-catalog",
    "tooling/static-fixtures",
    "artwork"
  ],
  "engines": {
    "node": ">=22.20 <23"
  },
  "packageManager": "pnpm@12.15.0"
}
