{
  "name": "maseaaao-tv",
  "private": true,
  "scripts": {
    "build": "bun run build:website",
    "build:website": "bun run --filter ./apps/website build",
    "build:all": "bun run --sequential build:website build:stream-info build:tuna build:widgets build:artwork build:diagnostics",
    "build:stream-info": "bun run --filter ./apps/stream-info build",
    "build:tuna": "bun run --filter ./apps/tuna-widget build",
    "build:widgets": "bun run --filter ./apps/obs-widgets build",
    "build:artwork": "bun run --filter ./artwork build",
    "build:diagnostics": "bun tooling/local/build-diagnostics.mjs",
    "check": "bun run --sequential check:source check:repository",
    "check:source": "biome ci --error-on-warnings . && bun run check:knip && bun test tests/biome-policy.test.mjs && bun run check:ui && bun run check:repository --source",
    "check:repository": "bun tooling/check-repository.mjs",
    "check:knip": "knip",
    "check:ui": "bun run --filter \"./apps/*\" check",
    "check:artifacts": "bun tooling/check-generated-artifacts.mjs",
    "check:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "lint": "biome lint --error-on-warnings .",
    "test": "bun run --sequential build:all test:checks",
    "test:checks": "bun run --sequential test:repository test:stream-info test:companion test:local",
    "test:repository": "bun tooling/artwork/cyber-site-test.mjs",
    "test:stream-info": "bun run --filter ./apps/stream-info test",
    "test:companion": "bun integrations/companion/shared/test-helper-process.mjs && bun integrations/companion/voice-control/test-guard.mjs && bun integrations/companion/voice-control/test-runtime.mjs",
    "test:local": "bun tooling/local/test-action-targets.mjs && bun test ./tooling/local/test-companion-storage.mjs",
    "test:releases": "bun test tests/release-products.test.mjs",
    "render:artwork": "bun tooling/artwork/cyber-site-render.mjs",
    "render:logo": "bun tooling/artwork/refresh-logo-qr.mjs",
    "render:scenes": "bun tooling/artwork/build-cyber-scenes.mjs",
    "render:all": "bun run render:logo && bun run render:scenes --prepared && bun run render:artwork all --prepared",
    "verify:artwork": "bun run render:logo && bun run build:artwork && bun run render:scenes --prepared && bun run render:artwork all --prepared && bun run optimize:images",
    "verify:ui-renewal": "bun run --sequential check:source verify:artwork build:all check:repository test:checks check:artifacts && git diff --check",
    "verify:companion": "bun run --sequential --filter './integrations/companion/*' build && bun run --sequential --filter './integrations/companion/*' package && bun integrations/companion/shared/test-packages.mjs",
    "browser:install": "playwright-core install chromium",
    "deploy:website": "bun run build:website && bunx --bun wrangler deploy",
    "sync:local": "bun tooling/sync-local.mjs",
    "optimize:images": "bun tooling/artwork/optimize-images.mjs",
    "full": "bun run --sequential build:all render:all optimize:images"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@maseaaao/build-config": "workspace:*",
    "@maseaaao/design": "workspace:*",
    "fflate": "0.8.3",
    "jsdom": "26.1.0",
    "jsonc-parser": "3.3.1",
    "jsqr": "^1.4.0",
    "knip": "6.43.0",
    "playwright-core": "1.58.2",
    "png-to-ico": "3.0.2",
    "postcss": "8.5.31",
    "postcss-import": "17.0.1",
    "postcss-url": "10.1.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.4",
    "wrangler": "4.152.0",
    "yaml": "2.8.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/companion/system-microphone",
    "integrations/companion/voice-control",
    "artwork"
  ],
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}
