{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!!**/dist",
      "!!build",

      "!!**/bin",
      "!!**/obj",
      "!bun.lock",
      "!**/packages.lock.json",
      "!apps/stream-info/streamerbot-import.txt",
      "!integrations/companion/*/main.js",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "whitespaceSensitivity": "css"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": true,
      "formatEmbeds": false
    },
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "useUniqueElementIds": "error"
      },
      "suspicious": {
        "noFocusedTests": "error",
        "noDuplicateSelectors": "off",
        "noUndeclaredEnvVars": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@maseaaao/*/src/**",
                  "**/packages/*/src/**",
                  "**/apps/*/src/**"
                ],
                "message": "Use workspace exports instead of another product internals."
              }
            ]
          }
        },
        "useTemplate": "off",
        "useVueNextTickPromise": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": { "match": ".*[.]tsx?" }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/obs-widgets/src/streamlabs-chat/*.html"],
      "linter": {
        "rules": {
          "a11y": {
            "useHtmlLang": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tooling/**/*.ts",
        "integrations/**/*.ts",
        "packages/build-config/**/*.ts",
        "apps/**/scripts/**/*.ts",
        "apps/**/vite.config.ts",
        "apps/**/build.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Use the globals provided by this file runtime.",
                  "document": "Use the globals provided by this file runtime.",
                  "navigator": "Use the globals provided by this file runtime.",
                  "localStorage": "Use the globals provided by this file runtime.",
                  "sessionStorage": "Use the globals provided by this file runtime.",
                  "location": "Use the globals provided by this file runtime.",
                  "alert": "Use the globals provided by this file runtime.",
                  "confirm": "Use the globals provided by this file runtime.",
                  "prompt": "Use the globals provided by this file runtime.",
                  "requestAnimationFrame": "Use the globals provided by this file runtime.",
                  "cancelAnimationFrame": "Use the globals provided by this file runtime."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/stream-info/scripts/verify*-live.ts",
        "tooling/artwork/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/**/src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "process": "Use the globals provided by this file runtime.",
                  "Buffer": "Use the globals provided by this file runtime.",
                  "require": "Use the globals provided by this file runtime.",
                  "module": "Use the globals provided by this file runtime.",
                  "exports": "Use the globals provided by this file runtime.",
                  "__dirname": "Use the globals provided by this file runtime.",
                  "__filename": "Use the globals provided by this file runtime.",
                  "global": "Use the globals provided by this file runtime.",
                  "setImmediate": "Use the globals provided by this file runtime.",
                  "clearImmediate": "Use the globals provided by this file runtime."
                }
              }
            }
          }
        }
      }
    }
  ],
  "plugins": [
    {
      "path": "./tooling/biome/no-type-assertions.grit",
      "includes": ["packages/ui/**/*.ts"]
    }
  ],
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
