{
  "name": "@maseaaao/website",
  "private": true,
  "type": "module",
  "exports": {
    "./ui.css": "./src/assets/site.css",
    "./qr.png": "./public/assets/maseaaao.tv.png",
    "./pages/*": "./src/*"
  },
  "scripts": {
    "build": "bun --bun vite build --configLoader native",
    "check": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "dev": "bun --bun vite --configLoader native --host 127.0.0.1"
  },
  "dependencies": {
    "@maseaaao/design": "workspace:*",
    "@maseaaao/ui": "workspace:*"
  },
  "devDependencies": {
    "@11ty/eleventy-img": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
