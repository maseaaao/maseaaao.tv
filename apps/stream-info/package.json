{
  "name": "change-info-streamer-bot",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ui.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "generate-import": "bun scripts/generate-import.mjs && bun scripts/verify-import.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run && dotnet run --project tests/csharp/StreamerbotTests.csproj --configuration Release",
    "build": "bun run generate-import && vite build && bun scripts/verify-build.mjs",
    "preview": "vite preview",
    "source": "bun ../../tooling/source-task.mjs"
  },
  "dependencies": {
    "@streamerbot/client": "2.0.1",
    "@maseaaao/design": "workspace:*",
    "@maseaaao/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "jsdom": "^26.1.0",
    "lucide-static": "^1.28.0",
    "simple-icons": "^16.27.1",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "^5.0.0",
    "@maseaaao/build-config": "workspace:*",
    "jsonc-parser": "3.3.1"
  }
}
