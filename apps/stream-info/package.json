{
  "name": "change-info-streamer-bot",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ui.css": "./src/styles.css"
  },
  "scripts": {
    "build": "bun run generate-import && bun --bun vite build --configLoader native && bun scripts/verify-build.ts",
    "check": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "dev": "bun run generate-import && bun --bun vite --configLoader native",
    "generate-import": "bun scripts/generate-import.ts && bun scripts/verify-import.ts",
    "preview": "bun --bun vite preview --configLoader native",
    "test": "bun test",
    "test:csharp": "dotnet run --project tests/csharp/StreamerbotTests.csproj --configuration Release"
  },
  "dependencies": {
    "@maseaaao/design": "workspace:*",
    "@maseaaao/ui": "workspace:*",
    "@streamerbot/client": "catalog:"
  },
  "devDependencies": {
    "@maseaaao/build-config": "workspace:*",
    "@sinonjs/fake-timers": "catalog:",
    "@types/bun": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "jsonc-parser": "catalog:",
    "lucide-static": "catalog:",
    "simple-icons": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-singlefile": "catalog:"
  }
}
